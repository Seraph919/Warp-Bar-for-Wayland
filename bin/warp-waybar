#!/usr/bin/env python3
"""Waybar status output and menu actions using the shared WARP helper."""
import html
import json
import os
from pathlib import Path
import runpy
import shlex
import shutil
import subprocess
import sys

HELPER = Path(__file__).resolve().with_name("warp")
backend = runpy.run_path(str(HELPER))
MENU = {
    "Connect": "connect", "Disconnect": "disconnect",
    "DNS only (DoH)": "doh", "WARP + DNS (DoH)": "warp+doh",
    "Block malware": "malware", "Block malware + adult content": "full",
    "Turn off family filtering": "off", "Check connection": "check",
    "Register WARP (first time)": "register",
}


def status_payload(data):
    state = ("missing" if not data.get("available") else
             "error" if not data.get("ok") else
             "connected" if data.get("connected") else "disconnected")
    return {"text": "WARP", "alt": state, "class": state,
            "tooltip": html.escape(data.get("message", "Unknown status"))}


def notify(message, failed=False):
    print(message)
    if shutil.which("notify-send"):
        try:
            subprocess.run(["notify-send", "--app-name=WARP", "--urgency=" +
                            ("critical" if failed else "normal"), "--",
                            "Cloudflare WARP", html.escape(message)], timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass


def terminal_command():
    configured = os.environ.get("WARP_TERMINAL")
    if configured:
        command = shlex.split(configured)
        if not command:
            raise ValueError("WARP_TERMINAL must contain a terminal command.")
        return command + [str(HELPER), "register"]
    for command in (["xdg-terminal-exec"], ["x-terminal-emulator", "-e"], ["foot"], ["kitty", "--"],
                    ["alacritty", "-e"], ["ghostty", "-e"],
                    ["gnome-terminal", "--"], ["konsole", "-e"]):
        if shutil.which(command[0]):
            return command + [str(HELPER), "register"]
    raise ValueError("No supported terminal found. Run warp-cli registration new in your terminal.")


def main(action):
    if action == "menu":
        try:
            result = subprocess.run(
                ["wofi", "--dmenu", "--prompt=WARP", "--cache-file=/dev/null"],
                input="\n".join(MENU) + "\n", capture_output=True, text=True)
        except OSError as error:
            notify("Cannot open WARP menu: " + str(error) + ". Install wofi.", True)
            return 1
        if result.returncode:
            return 0  # Escape/cancel must never trigger a WARP command.
        selected = MENU.get(result.stdout.strip())
        if selected is None:
            return 0  # Ignore arbitrary text entered into the launcher.
        return main(selected)
    if action == "status":
        print(json.dumps(status_payload(backend["run"]("status"))))
        return 0
    if action == "register":
        if not shutil.which("warp-cli"):
            notify(backend["MISSING"], True)
            return 1
        try:
            result = subprocess.run(terminal_command())
            if result.returncode:
                notify("Registration terminal failed. Run warp-cli registration new manually.", True)
            return result.returncode
        except (OSError, ValueError) as error:
            notify(str(error), True)
            return 1
    if action not in backend["COMMANDS"] and action != "check":
        notify("Unknown WARP action", True)
        return 1
    data = backend["run"](action)
    notify(data["message"], not data["ok"])
    return 0 if data["ok"] else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) == 2 else "status"))
